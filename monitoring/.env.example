# Salin file ini menjadi .env lalu isi MT_PASS dengan password user webmon
# Alamat REST API router lewat SSH tunnel (dibuka otomatis oleh server.js)
MT_URL=http://127.0.0.1:18080
MT_USER=webmon
MT_PASS=

# Jaringan yang dipantau
LAN_PREFIX=172.19.26.
WAN_IF=ether1_INTERNET
LAN_IF=ether4

# Port web monitoring di PC ini (buka http://localhost:8090)
PORT=8090
# 0.0.0.0 = bisa dibuka dari PC/HP lain di jaringan kantor (http://IP-PC-INI:8090)
# 127.0.0.1 = hanya bisa dibuka dari PC ini
LISTEN_HOST=0.0.0.0
POLL_MS=3000

# Tunnel SSH otomatis (pakai SSH key, tanpa password)
# Alamat DDNS router (IP > Cloud di MikroTik), mis. xxxxxxxx.sn.mynetname.net
SSH_HOST=
SSH_PORT=22
SSH_USER=webmon
SSH_KEY=C:\Users\GILANG\.ssh\mt_ternate_webmon
TUNNEL_TARGET=172.19.26.1:80

# Ping dari router tiap 30 detik (Label=alamat); yang pertama = patokan internet
PING_TARGETS=Internet=8.8.8.8,BAKUDAPA=bakudapa.malutprov.go.id
# Lama riwayat disimpan (hari)
KEEP_DAYS=90
